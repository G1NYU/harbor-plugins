{
  "name": "harbor-plugins",
  "version": "1.0.0",
  "description": "Multi-repository management and hosting system for Harbor Manga and eBook plugins",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx scripts/build.ts && tsx scripts/convert-paperback.ts",
    "convert": "tsx scripts/convert-paperback.ts",
    "sync-upstream": "tsx scripts/build.ts && tsx scripts/convert-paperback.ts && tsx scripts/validate.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "serve": "tsx scripts/serve.ts",
    "test:extensions": "tsx scripts/test-extensions.ts",
    "test:quick": "tsx scripts/test-extensions.ts --popular-only",
    "test:all": "tsx scripts/test-extensions.ts --all"
  },
  "keywords": [
    "harbor",
    "manga",
    "ebook",
    "plugins",
    "extensions",
    "reader"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
